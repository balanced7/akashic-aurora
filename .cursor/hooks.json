{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "uv run agent/harness/hooks/cursor_sessionstart.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "uv run agent/harness/hooks/cursor_beforeshell.py",
        "matcher": "git\\s+(add|commit)",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "uv run agent/harness/hooks/cursor_pretooluse.py",
        "matcher": "Shell|Write"
      }
    ],
    "postToolUse": [
      {
        "command": "uv run agent/harness/hooks/cursor_posttooluse.py",
        "matcher": "Shell|Read|Write"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "uv run agent/harness/hooks/cursor_posttooluse.py --event postToolUseFailure",
        "matcher": "Shell|Read|Write"
      }
    ],
    "sessionEnd": [
      {
        "command": "uv run agent/harness/hooks/cursor_sessionend.py"
      }
    ]
  }
}
