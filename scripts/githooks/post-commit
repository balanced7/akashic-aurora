#!/bin/sh
# post-commit -- record WHICH SEAT made this commit (scripts/githooks/post_commit.py).
# Git can no longer say: T411 inverted author AND committer to the operator, so the seat
# exists only in the environment at the moment of the commit. Fail-open by design -- a
# commit that already happened must never be undone by its own bookkeeping.
# `py` is the Windows launcher. Elsewhere run Aurora's Python through uv (its dependencies
# come with it), else python3 -- so every `py ...` line below works on any OS unchanged.
command -v py >/dev/null 2>&1 || py() { if command -v uv >/dev/null 2>&1; then uv run "$@"; else python3 "$@"; fi; }
py scripts/githooks/post_commit.py
