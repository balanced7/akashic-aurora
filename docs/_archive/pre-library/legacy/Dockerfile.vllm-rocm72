# Custom vLLM container with ROCm 7.2.1 for AMD RX 9070 XT (gfx1201)
# Built from Ubuntu 24.04 with fresh ROCm 7.2.1 installation
# E:\AI-Setup\Dockerfile.vllm-rocm72

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install base dependencies
RUN apt-get update && apt-get install -y \
    wget \
    gnupg2 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Add ROCm 7.2.1 repository (using 'noble' for Ubuntu 24.04)
# Install the key to trusted keyring directory
RUN wget -q -O /etc/apt/keyrings/rocm.gpg.key https://repo.radeon.com/rocm/rocm.gpg.key && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg.key] https://repo.radeon.com/rocm/apt/7.2.1 noble main" > /etc/apt/sources.list.d/rocm.list && \
    apt-get update

# Remove any existing ROCm packages if present, then install fresh ROCm 7.2.1
RUN apt-get remove -y rocm* hip* miopen* rocblas* 2>/dev/null || true && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/*

# Install ROCm 7.2.1 core libraries with specific versions
RUN apt-get update && apt-get install -y --no-install-recommends \
    rocm7.2.1 \
    rocm-dev7.2.1 \
    hipblas7.2.1 \
    rocblas7.2.1 \
    miopen-hip7.2.1 \
    rocsolver7.2.1 \
    rocfft7.2.1 \
    hiprand7.2.1 \
    hipsparse7.2.1 \
    hipsolver7.2.1 \
    hipfft7.2.1 \
    hipsparselt7.2.1 \
    rocm-libs7.2.1 \
    && rm -rf /var/lib/apt/lists/* /tmp/*

# Verify ROCm installation
RUN echo "=== Installed ROCm packages ===" && \
    dpkg -l | grep -E "^ii.*rocm" | awk '{print $2, $3}'

# Set ROCm environment
ENV ROCM_PATH=/opt/rocm
ENV HSA_ENABLE_DXG_DETECTION=1
ENV LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:${LD_LIBRARY_PATH}
ENV PATH=/opt/rocm/bin:${PATH}

# Install Python 3.12 and PyTorch with ROCm
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3-pip \
    python3.12-dev \
    git \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
    && ln -sf /usr/bin/pip3 /usr/bin/pip \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch with ROCm support (try 7.2.1 first, fallback to 7.1)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/rocm7.2 || \
    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/rocm7.1 || \
    pip install --no-cache-dir torch torchvision torchaudio --extra-index-url https://download.pytorch.org/whl/rocm7.1

# Install vLLM
RUN pip install --no-cache-dir vllm

# Copy test script
COPY test_torch.py /test_torch.py

# Health check - verify GPU detection
CMD ["python3", "/test_torch.py"]
