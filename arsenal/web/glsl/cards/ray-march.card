//! {"card": "ray-march", "uses": ["ray-march", "ray-camera", "sdf-shapes", "debug-views", "dither-masks", "colour-transfer"], "t": [0, 2], "size": [480, 270],
//!  "note": "One scene (a ball, a cube, a floor) six ways, read row by row from the top left. TOP: rmSphereTrace, each hit pulled onto the offset surface by rmRefine and shaded, with a hard shadow traced from rmSecondaryOrigin (a shadow under the ball, no black speckle on the lit surfaces); the step count of that march as heat (black few, white many, magenta over the 96-step budget): the horizon and the silhouettes glow, the faces stay dark; the step count of rmRelaxed at omega 1.6 on the same scale: darker over the open floor and sky, except a sharp-edged halo round the objects where a relaxed step once failed its overlap check and the march fell back to plain steps, matching the panel beside it there and never exceeding it. BOTTOM: the field made to claim 1.4 times its distance, marched by rmSphereTrace and coloured by how many hit epsilons its hit lies from the true surface (the ball and cube bright: it stops inside the solids); the same lying field marched by rmBacktrack (the ball and cube black: its bisection lands on the surface); in both, the floor shows the same faint rings, hits stopping within their own half-pixel epsilon; then one narrow view of the ball twice, glowing by a pass-through march (rmPassStep, never stopping at the surface, its step floored at 0.3): started at 0 (left) it shows a false inner ring inside the rim (banding), started by rmJitterStart from a static mask (right) the ring dissolves into fine grain. The camera turns a little between t = 0 and t = 2. A broken marcher shows holes or a halo of floor colour round the silhouettes top left, magenta over the heat maps, a bright ball in the bottom-middle panel, or bands on the right of the glow."}
// Apache-2.0, Akashic Aurora. The test card for ray/march.glsl, written fresh.

int marchCardMode = 0;       // 0: the honest scene; 1: the same scene claiming 1.4 times its distance

float marchCardBall(vec3 p) {
    return sdSphere(p - vec3(-0.6, 0.55, 0.0), 0.55);
}

float marchCardCube(vec3 p) {
    return sdBox(p - vec3(0.7, 0.4, -0.25), vec3(0.4));
}

float mapScene(vec3 p) {
    float scene = min(min(marchCardBall(p), marchCardCube(p)), p.y);
    return marchCardMode == 1 ? 1.4 * scene : scene;
}

// The honest field's normal by six taps (the card's own, so the marcher is tested without the normals module).
vec3 marchCardNormal(vec3 p) {
    float h = 1e-3;
    return normalize(vec3(mapScene(p + vec3(h, 0.0, 0.0)) - mapScene(p - vec3(h, 0.0, 0.0)),
                          mapScene(p + vec3(0.0, h, 0.0)) - mapScene(p - vec3(0.0, h, 0.0)),
                          mapScene(p + vec3(0.0, 0.0, h)) - mapScene(p - vec3(0.0, 0.0, h))));
}

void mainImage(out vec4 color, in vec2 pixel) {
    vec2 panelSize = vec2(160.0, 135.0);
    vec2 cell = floor(pixel / panelSize);
    vec2 local = pixel - cell * panelSize;
    int which = int(1.0 - cell.y) * 3 + int(cell.x);
    float focal = 1.7;
    float pixelAngle = camPixelAngle(2.0 * atan(1.0 / focal), panelSize.y);
    vec3 ro = vec3(2.4 * cos(0.25 + 0.1 * iTime), 1.5, 3.2 + 0.4 * sin(0.1 * iTime));
    mat3 basis = camLookAt(ro, vec3(0.0, 0.35, 0.0), 0.0);
    vec3 rd = camRay(local, panelSize, basis, focal);
    vec2 range = vec2(0.0, 20.0);
    vec3 sky = vec3(0.32, 0.42, 0.6);
    vec3 paint;
    bool display = false;            // true when paint is already a display colour (the heat maps)

    if (which == 0) {
        marchCardMode = 0;
        vec4 march = rmSphereTrace(ro, rd, range, pixelAngle, 1.0, 96);
        paint = sky;
        if (march.w > 0.5) {
            float t = rmRefine(ro, rd, march.x, pixelAngle, 3);
            vec3 at = ro + rd * t;
            vec3 n = marchCardNormal(at);
            vec3 sunDir = normalize(vec3(0.5, 0.8, 0.35));
            vec3 start = rmSecondaryOrigin(at, n, mapScene(at), 1e-3, 1.0);
            vec4 toSun = rmSphereTrace(start, sunDir, vec2(0.0, 10.0), pixelAngle, 1.0, 64);
            float lit = toSun.w > 0.5 ? 0.0 : max(dot(n, sunDir), 0.0);
            float onBall = marchCardBall(at);
            float onCube = marchCardCube(at);
            vec3 albedo = at.y < min(onBall, onCube) ? vec3(0.5)
                        : (onBall < onCube ? vec3(0.85, 0.35, 0.25) : vec3(0.3, 0.55, 0.85));
            paint = albedo * (0.12 + 0.88 * lit) + 0.08 * sky * (0.5 + 0.5 * n.y);
        }
    } else if (which == 1 || which == 2) {
        marchCardMode = 0;
        vec4 march = which == 1 ? rmSphereTrace(ro, rd, range, pixelAngle, 1.0, 96)
                                : rmRelaxed(ro, rd, range, pixelAngle, 1.6, 96);
        paint = dbgHeatCount(march.y, 96.0);
        display = true;
    } else if (which == 3 || which == 4) {
        marchCardMode = 1;
        vec4 lying = which == 3 ? rmSphereTrace(ro, rd, range, pixelAngle, 1.0, 96)
                                : rmBacktrack(ro, rd, range, pixelAngle, 96, 12);
        marchCardMode = 0;
        // how far from the true surface the reported hit lies, read from the honest field there, in hit epsilons
        float miss = lying.w > 0.5 ? abs(mapScene(ro + rd * lying.x)) : 0.0;
        paint = dbgHeatRamp(miss / (12.0 * rmEpsilon(lying.x, pixelAngle, 1e-4)));
        display = true;
    } else {
        // the same narrow view of the ball in both halves: a pass-through glow that never stops at the surface, its
        // step floored at 0.3 (coarser than the glow's own width, so a fixed start bands); the right half starts each
        // ray a static fraction of a step in
        vec2 halfSize = vec2(80.0, 135.0);
        vec2 inHalf = vec2(mod(local.x, 80.0), local.y);
        vec3 eye = vec3(-0.6, 0.9, 2.6);
        vec3 look = camRay(inHalf, halfSize, camLookAt(eye, vec3(-0.6, 0.55, 0.0), 0.0), 2.2);
        float t = local.x < 80.0 ? 0.0 : rmJitterStart(0.0, 0.3, dthIgn(pixel));
        float glow = 0.0;
        for (int stepIndex = 0; stepIndex < 48; stepIndex++) {
            vec3 at = eye + look * t;
            float d = marchCardBall(at);
            float stride = rmPassStep(d, 0.3, 4.0);
            glow += exp(-14.0 * abs(d)) * stride;
            t += stride;
            if (t > 6.0) {
                break;
            }
        }
        paint = vec3(0.25, 0.7, 1.0) * 1.6 * glow + vec3(0.01, 0.01, 0.03);
    }
    if (!display) {
        vec3 shown = clamp(paint, 0.0, 1.0);
        paint = srgbEncode(shown);
    }
    vec2 toBorder = min(local, panelSize - local);
    paint *= smoothstep(0.5, 1.5, min(toBorder.x, toBorder.y));
    color = vec4(paint, 1.0);
}
