//! {"card": "atmos-aurora", "uses": ["atmos-aurora", "colour-tone"], "t": [0, 2], "size": [480, 270],
//!  "note": "Altitude runs up the whole card from 80 km (bottom) to 340 km (top). LEFT, the parts alone, each shown as
//!  hue (scaled so its brightest channel is 1): the first column is auroraLineColor for a quiet display, black low
//!  down, then the yellow-green 557.7 nm body from about 95 to 108 km up, passing through orange into pure red above
//!  about 250 km (physical order: green under red). The second column is the same with energetic = 1: a violet band
//!  at the bottom turning pink-lavender where it meets the green, gone by about 112 km. The third
//!  column plots auroraProfile (brightness left to right) for a hem at 95 km (amber tick): zero below the tick, a
//!  near-vertical rise, the peak touching the column's right edge about 13 km up (white, scale height 40 km), then a
//!  long fade; the grey curve (scale height 80 km) fades more slowly and stands taller. RIGHT, the parts together: a
//!  curtain over a near-black sky, seen side on: a sharp, gently wavering lower hem with a faint purple edge, a bright
//!  green body that fades upward into a dim red crown, and fine vertical rays of uneven brightness running its full
//!  height. Between t = 0 and t = 2 the rays slide sideways and the hem shifts slightly. Red under green, a soft hem
//!  with a hard top, slanted rays, or identical frames is a broken module."}
// Apache-2.0, Akashic Aurora. The test card of atmos/aurora.glsl, written fresh for the house.

// About one pixel of ink at distance d (in pixels).
float auroraCardInk(float d) {
    return 1.0 - smoothstep(0.5, 1.5, d);
}

void mainImage(out vec4 color, in vec2 pixel) {
    float alt = 80.0 + pixel.y / 270.0 * 260.0;
    float kmPerPx = 260.0 / 270.0;
    vec3 paint = vec3(0.0);
    if (pixel.x < 46.0 || (pixel.x >= 50.0 && pixel.x < 96.0)) {
        vec3 hue = auroraLineColor(alt, pixel.x < 46.0 ? 0.0 : 1.0);
        paint = hue / max(max(hue.r, max(hue.g, hue.b)), 1.0);       // hue only: overlapping lines never clip to white
    } else if (pixel.x >= 100.0 && pixel.x < 150.0) {
        paint = vec3(0.04, 0.045, 0.06);
        float across = (pixel.x - 100.0) / 50.0;                     // 0 to 1, the profile's value
        paint = mix(paint, vec3(1.0, 0.65, 0.15), auroraCardInk(abs(alt - 95.0) / kmPerPx) * step(across, 0.25));
        float scales[2] = float[2](80.0, 40.0);
        vec3 inks[2] = vec3[2](vec3(0.45), vec3(0.95));
        for (int curve = 0; curve < 2; ++curve) {
            float v = auroraProfile(alt, 95.0, scales[curve]);
            float slope = (auroraProfile(alt + kmPerPx, 95.0, scales[curve]) - v) * 50.0;   // pixels across per pixel up
            float miss = abs(across - v) * 50.0 / sqrt(1.0 + slope * slope);
            paint = mix(paint, inks[curve], auroraCardInk(miss));
        }
    } else if (pixel.x >= 154.0) {
        float along = (pixel.x - 154.0) / 326.0 * 8.0;              // eight ray units across the panel
        float hem = 100.0 + 6.0 * sin(0.9 * along + 0.35 * iTime) + 2.5 * sin(2.3 * along - 0.6 * iTime);
        float bright = auroraProfile(alt, hem, 55.0);
        float rays = auroraRays(1.5 * along, iTime, 7u);
        vec3 emitted = 0.8 * auroraLineColor(alt, 0.35) * bright * mix(0.3, 1.0, rays);
        vec3 sky = vec3(0.002, 0.004, 0.012);
        paint = displayHueSafeGamma(sky + emitted, 2.2);              // the hue of the summed glow survives
    }
    color = vec4(clamp(paint, 0.0, 1.0), 1.0);
}
