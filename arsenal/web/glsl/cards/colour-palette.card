//! {"card": "colour-palette", "uses": ["colour-palette", "colour-tone"], "t": [0], "size": [480, 270],
//!  "note": "Top to bottom. Quilez's cosine rainbow, its upper half palCos shown as is and its lower half palCosLinear
//!  encoded: the two halves must be identical, with no seam between them (the same palette in two currencies). An OKLCH
//!  sweep with palOklch: every hue at one lightness, no bright yellow band and no dark blue trough. palRamp3 through
//!  cyan, electric blue and indigo: one calm analogous gradient. palHeatPowers, upper an ember (black, red, orange,
//!  yellow, white), lower a neon blue that whitens. Then the twelve pitch colours of palPitchFifths in circle-of-fifths
//!  order (C, G, D, A, E, B, F#, C#, G#, D#, A#, F) as the piano shows them through PBR Neutral: C is teal, and the hues
//!  walk evenly through blue, violet, magenta, red, orange, yellow and green back toward teal, all at a similar
//!  brightness. A seam in the top bar, a lightness band in the sweep, or a pitch row that jumps or has one swatch far
//!  brighter than the rest is a broken module."}
// Apache-2.0, Akashic Aurora. The card for colour/palette.glsl: five palettes and the twelve note colours.

void mainImage(out vec4 color, in vec2 pixel) {
    vec3 paint = vec3(0.05, 0.055, 0.07);
    float margin = 12.0;
    float along = (pixel.x - margin) / (iResolution.x - 2.0 * margin);
    float y = pixel.y;
    if (along >= 0.0 && along <= 1.0) {
        if (y >= 226.0 && y <= 258.0) {
            vec3 a = vec3(0.5);
            vec3 b = vec3(0.5);
            vec3 c = vec3(1.0);
            vec3 d = vec3(0.0, 1.0 / 3.0, 2.0 / 3.0);
            paint = y >= 242.0 ? palCos(along, a, b, c, d) : srgbEncode(palCosLinear(along, a, b, c, d));
        } else if (y >= 190.0 && y <= 220.0) {
            paint = srgbEncode(palOklch(along, 0.7, 0.12, 0.0, 1.0));
        } else if (y >= 154.0 && y <= 184.0) {
            vec3 cyan = srgbDecode(vec3(0.0, 0.65, 0.85));
            vec3 electric = srgbDecode(vec3(0.08, 0.38, 1.0));
            vec3 indigo = srgbDecode(vec3(0.32, 0.18, 0.92));
            paint = srgbEncode(palRamp3(along, cyan, electric, indigo));
        } else if (y >= 118.0 && y <= 148.0) {
            vec3 exps = y >= 133.0 ? vec3(1.0, 2.0, 4.0) : vec3(3.0, 1.4, 0.6);
            paint = srgbEncode(min(palHeatPowers(along, exps), vec3(1.0)));
        } else if (y >= 18.0 && y <= 108.0) {
            float slot = min(floor(along * 12.0), 11.0);
            float gap = fract(along * 12.0);
            if (gap > 0.07 && gap < 0.93) {
                float pitchClass = mod(slot * 7.0, 12.0);                     // the circle of fifths from C
                vec3 note = palPitchFifths(pitchClass, 4.0, palPitchPiano());
                paint = srgbEncode(tmPbrNeutral(note));
            }
        }
    }
    color = vec4(paint, 1.0);
}
