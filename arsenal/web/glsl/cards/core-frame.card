//! {"card": "core-frame", "uses": ["core-frame"], "t": [0], "size": [480, 270],
//!  "note": "The house frame: a gold circle of radius 1 that is round (not an ellipse) and touches the top and bottom edges exactly, with white axes crossing at the canvas centre. Left half: a straight grid every 0.25 units whose lines are one pixel wide by uvPixel. Right half: the same grid seen through a lens that stretches it more the farther out it goes. Upper right (cyan), each line is drawn one pixel wide by uvFootprint, measured through the warp, and stays one even pixel everywhere. Lower right (orange), the same lines drawn with the unwarped uvPixel: they thin out and break into dots toward the edge, which is what forgetting the warp looks like."}
// Apache-2.0, Akashic Aurora. The test card for core/frame.glsl, written fresh.

void mainImage(out vec4 color, in vec2 pixel) {
    vec2 p = uvCentered(pixel, iResolution.xy);
    float px = uvPixel(iResolution.xy);
    vec2 lens = p * (1.0 + 0.9 * dot(p, p));          // a warped copy of the frame
    float lensPx = uvFootprint(lens);                 // measured for every pixel, before anything branches
    vec3 paint = vec3(0.04, 0.05, 0.07);

    if (p.x < 0.0) {
        vec2 toLine = abs(fract(p / 0.25 + 0.5) - 0.5) * 0.25;
        float gridInk = 1.0 - smoothstep(0.5, 1.0, min(toLine.x, toLine.y) / px);
        paint = mix(paint, vec3(0.3, 0.33, 0.4), gridInk);
    } else {
        vec2 toLensLine = abs(fract(lens / 0.25 + 0.5) - 0.5) * 0.25;
        bool measured = p.y > 0.0;
        float lineWidth = measured ? lensPx : px;
        float lensInk = 1.0 - smoothstep(0.5, 1.0, min(toLensLine.x, toLensLine.y) / lineWidth);
        paint = mix(paint, measured ? vec3(0.3, 0.85, 0.95) : vec3(1.0, 0.6, 0.25), lensInk);
    }
    vec2 offAxis = abs(p);
    float axis = min(offAxis.x, offAxis.y) / px;
    paint = mix(paint, vec3(0.9), 1.0 - smoothstep(0.5, 1.0, axis));
    float ring = abs(length(p) - 1.0) / px;
    paint = mix(paint, vec3(1.0, 0.78, 0.3), 1.0 - smoothstep(0.6, 1.3, ring));
    color = vec4(paint, 1.0);
}
