//! {"card": "core-clock", "uses": ["core-clock"], "t": [0, 0.75], "size": [480, 270],
//!  "note": "Top: three phase bars at 0.5, 1 and 2 cycles per second, empty at t = 0 and filled to 0.375, 0.75 and 0.5 at t = 0.75 (the 2 Hz bar has wrapped once). Middle: one second of a decay that keeps 5 percent per second. The grey curve is the truth; the blue staircase (30 frames a second) and the orange one (240 a second) use clkKeep and both stand on it. The red staircase is a per-frame factor tuned at 60 Hz run at 240 Hz: it falls four times too fast. Bottom: a smoother chasing a step with a time constant of 0.2 s (dim marks at 0.2 s and 63 percent): the grey truth, and clkAlpha at 30 and 240 frames a second, both on it. A staircase that leaves the grey curve is a clock that changes with the monitor."}
// Apache-2.0, Akashic Aurora. The test card for core/clock.glsl, written fresh.

// Ink for a curve crossing this pixel column. It enters at one height and leaves at another (all three in pixels:
// the column's left edge, middle and right edge), so it covers the span between them; a pixel is lit by how close it
// is to that span. Flat, steep, a jump or an asymptote: each stays one even stroke.
float clockCardLine(float yPx, float leftPx, float middlePx, float rightPx) {
    float low = min(leftPx, min(middlePx, rightPx));
    float high = max(leftPx, max(middlePx, rightPx));
    float outside = max(max(low - yPx, yPx - high), 0.0);
    return 1.0 - smoothstep(0.5, 1.3, outside);
}

// Plot 0 is the decay, plot 1 the smoother. which: 0 truth, 1 at 30 Hz, 2 at 240 Hz, 3 (decay only) 60 Hz at 240 Hz.
float clockCardCurve(int plot, int which, float seconds) {
    float keep = 0.05;
    float tau = 0.2;
    float t = max(seconds, 0.0);
    float hz = which == 1 ? 30.0 : 240.0;
    float frames = floor(t * hz);
    if (plot == 0) {
        if (which == 0) {
            return pow(keep, t);
        }
        float perFrame = clkKeep(keep, which == 3 ? 1.0 / 60.0 : 1.0 / hz);
        return pow(perFrame, frames);
    }
    if (which == 0) {
        return 1.0 - exp(-t / tau);
    }
    return 1.0 - pow(1.0 - clkAlpha(1.0 / hz, tau), frames);
}

void mainImage(out vec4 color, in vec2 pixel) {
    vec3 paint = vec3(0.04, 0.05, 0.07);
    float left = 20.0;
    float width = iResolution.x - 40.0;
    float seconds = (pixel.x - left) / width;
    bool inWidth = seconds >= 0.0 && seconds <= 1.0;

    // ---- phase bars
    for (int bar = 0; bar < 3; bar++) {
        float hz = 0.5 * pow(2.0, float(bar));
        float centreY = 246.0 - 18.0 * float(bar);
        if (abs(pixel.y - centreY) < 6.0 && inWidth) {
            float filled = clkPhase(iTime, hz);
            vec3 hue = bar == 0 ? vec3(0.4, 0.65, 1.0) : (bar == 1 ? vec3(0.45, 0.9, 0.55) : vec3(1.0, 0.62, 0.22));
            paint = seconds < filled ? hue : vec3(0.12, 0.13, 0.16);
            float quarter = abs(fract(seconds * 4.0 + 0.5) - 0.5) * width / 4.0;
            paint = mix(paint, vec3(0.5), (1.0 - smoothstep(0.5, 1.2, quarter)) * 0.6);
        }
    }

    // ---- the two plots: decay (y 110..190) and smoother (y 15..100)
    for (int plot = 0; plot < 2; plot++) {
        float bottom = plot == 0 ? 110.0 : 15.0;
        float height = plot == 0 ? 80.0 : 85.0;
        float level = (pixel.y - bottom) / height;
        if (!inWidth || level < -0.05 || level > 1.05) {
            continue;
        }
        if (level >= 0.0 && level <= 1.0) {
            paint = vec3(0.08, 0.09, 0.11);
        }
        if (plot == 1) {
            float markPx = min(abs(seconds - 0.2) * width, abs(level - (1.0 - exp(-1.0))) * height);
            paint = mix(paint, vec3(0.25, 0.27, 0.33), 1.0 - smoothstep(0.4, 1.0, markPx));
        }
        int curves = plot == 0 ? 4 : 3;
        for (int which = 0; which < 4; which++) {
            if (which >= curves) {
                break;
            }
            vec3 heights = vec3(clockCardCurve(plot, which, seconds - 0.5 / width), clockCardCurve(plot, which, seconds),
                                clockCardCurve(plot, which, seconds + 0.5 / width));
            float ink = clockCardLine(level * height, heights.x * height, heights.y * height, heights.z * height);
            vec3 hue = which == 0 ? vec3(0.6) : (which == 1 ? vec3(0.4, 0.65, 1.0)
                     : (which == 2 ? vec3(1.0, 0.62, 0.22) : vec3(1.0, 0.3, 0.3)));
            paint = mix(paint, hue, ink * (which == 0 ? 0.8 : 1.0));
        }
    }
    color = vec4(paint, 1.0);
}
