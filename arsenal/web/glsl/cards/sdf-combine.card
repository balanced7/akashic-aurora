//! {"card": "sdf-combine", "uses": ["sdf-combine", "sdf-shapes", "debug-views", "core-rotate"], "t": [0, 2], "size": [640, 360],
//!  "note": "Sixteen distance slices (z = 0) of a sphere A (left) and a tilted box B (right, sliding right as t grows), read row by row from the top left. Row 1: union, intersection (the lens where they overlap), A minus B (a bite out of the sphere's right side; the house order), xor (both shapes with their overlap hollow). Row 2: smooth union k = 0.15 (a fillet in the notches where they meet), smooth intersection, smooth A minus B (the bite with rounded lips), circular smooth union (the same fillet, rounder). Row 3: exponential smooth union (softer everywhere, including where the shapes do not touch), smooth union with k = 0.5 (one blob: sinew), the box rounded by 0.2 (bigger, round corners), the sphere as two nested shells (onion twice). Row 4: the box scaled 1.3 times by evaluating it at p / 1.3 (bigger, iso-lines still evenly spaced), the sphere displaced by a sine bump and divided by 1 + L, a material pick (A coral, B teal, the boundary where their distances are equal) and a smooth-union material mix (coral fading into teal through the fillet). Warm inside, cool outside, white zero line, iso-lines every 0.2. Magenta would mark a field changing faster than distance: there is none on any panel, including the displaced sphere. Between t = 0 and t = 2 B slides 0.15 to the right and every panel changes with it. A broken operator shows a bite on the wrong shape (subtract order), a fillet on the outer corners (a blend that is not rigid), or magenta."}
// Apache-2.0, Akashic Aurora. The test card for sdf/combine.glsl, written fresh.

const float COMBINE_SPAN = 2.6;      // world units across a panel's height

float combineCardSphere(vec3 p) {
    return sdSphere(p - vec3(-0.4, 0.0, 0.0), 0.75);
}

float combineCardBox(vec3 p) {
    vec3 centre = vec3(0.35 + 0.15 * sin(0.9 * iTime), 0.15, 0.0);
    vec3 local = p - centre;
    local.xy = rotate2(-0.35) * local.xy;
    return sdBox(local, vec3(0.6, 0.45, 0.45));
}

// The field of panel `which` at p; `material` comes back -1 (none) or the share of B's colour (0 coral to 1 teal).
float combineCardField(int which, vec3 p, out float material) {
    material = -1.0;
    float a = combineCardSphere(p);
    float b = combineCardBox(p);
    if (which == 0) { return opUnion(a, b); }
    if (which == 1) { return opIntersect(a, b); }
    if (which == 2) { return opSubtract(a, b); }
    if (which == 3) { return opXor(a, b); }
    if (which == 4) { return opSmin(a, b, 0.15); }
    if (which == 5) { return opSmax(a, b, 0.15); }
    if (which == 6) { return opSsubtract(a, b, 0.15); }
    if (which == 7) { return opSminCircular(a, b, 0.15); }
    if (which == 8) { return opSminExp(a, b, 0.15); }
    if (which == 9) { return opSmin(a, b, 0.5); }
    if (which == 10) { return opRound(b, 0.2); }
    if (which == 11) { return opOnion(opOnion(a, 0.22), 0.06); }
    if (which == 12) {
        float scale = 1.3;
        return opUniformScale(combineCardBox(p / scale), scale);
    }
    if (which == 13) {
        vec3 wave = sin(8.0 * p + 0.5);
        float bump = 0.08 * wave.x * wave.y * wave.z;
        return opDisplace(a, bump, 0.08 * 8.0);           // amplitude times frequency: the bump's steepest slope

    }
    if (which == 14) {
        vec2 picked = opPick(vec2(a, 0.0), vec2(b, 1.0));
        material = picked.y;
        return picked.x;
    }
    vec2 mixed = opSminMix(a, b, 0.15);
    material = mixed.y;
    return mixed.x;
}

void mainImage(out vec4 color, in vec2 pixel) {
    vec2 panelSize = vec2(160.0, 90.0);
    vec2 cell = floor(pixel / panelSize);
    int which = int(3.0 - cell.y) * 4 + int(cell.x);
    vec2 local = pixel - (cell + 0.5) * panelSize;
    float unitsPerPx = COMBINE_SPAN / panelSize.y;
    vec3 p = vec3(local * unitsPerPx, 0.0);
    float material;
    float d = combineCardField(which, p, material);
    vec3 paint = dbgSlice(d, 0.2);
    if (material >= 0.0 && d < 0.0) {
        vec3 coral = vec3(0.95, 0.42, 0.3);
        vec3 teal = vec3(0.2, 0.72, 0.68);
        paint = mix(paint, mix(coral, teal, material), 0.7);
    }

    // how fast the field changes, over half a pixel in all three directions: never faster than distance
    float h = 0.5 * unitsPerPx;
    float unused;
    vec3 slope = vec3(combineCardField(which, p + vec3(h, 0.0, 0.0), unused)
                      - combineCardField(which, p - vec3(h, 0.0, 0.0), unused),
                      combineCardField(which, p + vec3(0.0, h, 0.0), unused)
                      - combineCardField(which, p - vec3(0.0, h, 0.0), unused),
                      combineCardField(which, p + vec3(0.0, 0.0, h), unused)
                      - combineCardField(which, p - vec3(0.0, 0.0, h), unused)) / (2.0 * h);
    float lies = smoothstep(1.03, 1.08, length(slope));
    paint = mix(paint, vec3(1.0, 0.0, 0.85), 0.8 * lies);

    vec2 toBorder = 0.5 * panelSize - abs(local);
    paint *= smoothstep(0.5, 1.5, min(toBorder.x, toBorder.y));
    color = vec4(paint, 1.0);
}
