//! {"card": "light-lights", "uses": ["light-lights", "colour-tone", "colour-transfer"], "t": [0], "size": [480, 270],
//!  "note": "LEFT, a floor seen from straight above, lit by three point lights hanging 0.35 units over it (amber, teal and violet, radii 1.0, 1.6 and 2.2 units, 50 px to the unit): each makes a pool, hot at its centre and falling off fast (inverse square times the cosine, so 1/r^3 on the floor), and each pool fades to exactly nothing ON the thin grey ring drawn where the light's window closes (where the distance to the light equals its radius). Where pools overlap their colours add. Nothing is lit outside every ring. RIGHT, falloff against distance, 0 to 3 units across, 0 to 4 up, for a light of radius 2: plain 1/d^2 (grey) and litInverseSquare (amber) lie on top of each other near the light, then the amber curve bends down to meet zero exactly at the vertical guide at 2 while the grey one keeps a long tail. Light outside a ring, an amber curve above the grey one, or a hard edge at a ring is a broken module."}
// Apache-2.0, Akashic Aurora. The test card of light/lights.glsl, written fresh for the house.

float lampCardInk(float d) {
    return 1.0 - smoothstep(0.6, 1.6, d);
}

void mainImage(out vec4 color, in vec2 pixel) {
    vec3 paint = vec3(0.03, 0.033, 0.04);
    const float hang = 0.35;
    if (pixel.x < 300.0) {
        vec2 spot = (pixel - vec2(6.0, 6.0)) / 50.0;                   // floor position in units, 50 px each
        vec2 lampAt[3] = vec2[3](vec2(1.6, 3.6), vec2(4.2, 3.4), vec2(2.9, 1.5));
        float lampRadius[3] = float[3](1.0, 1.6, 2.2);
        vec3 lampCol[3] = vec3[3](vec3(1.0, 0.55, 0.15), vec3(0.15, 0.8, 0.75), vec3(0.6, 0.3, 1.0));
        vec3 floorLight = vec3(0.0);
        float ring = 1e9;
        for (int lamp = 0; lamp < 3; lamp++) {
            vec2 apart = spot - lampAt[lamp];
            float toLamp = sqrt(dot(apart, apart) + hang * hang);
            float cosine = hang / toLamp;                              // the floor faces straight up
            floorLight += lampCol[lamp] * litInverseSquare(toLamp, lampRadius[lamp]) * cosine;
            float closes = sqrt(lampRadius[lamp] * lampRadius[lamp] - hang * hang);   // where the window shuts on the floor
            ring = min(ring, abs(length(apart) - closes) * 50.0);
        }
        paint = vec3(0.012) + 0.45 * floorLight;
        paint = srgbEncode(tmTanh(paint));
        paint = mix(paint, vec3(0.42, 0.44, 0.5), 0.8 * lampCardInk(ring));
    } else {
        vec2 box = pixel - vec2(312.0, 14.0);
        vec2 size = vec2(156.0, 242.0);
        if (all(greaterThanEqual(box, vec2(0.0))) && all(lessThanEqual(box, size))) {
            paint = vec3(0.07, 0.075, 0.09);
            float unitsPerPx = 3.0 / size.x;
            float d = box.x * unitsPerPx;
            paint = mix(paint, vec3(0.3, 0.31, 0.36), lampCardInk(abs(d - 2.0) / unitsPerPx));
            float yScale = size.y / 4.0;
            float plain = 1.0 / max(d * d, 1e-4);
            float windowed = litInverseSquare(d, 2.0);
            float plainNext = 1.0 / max((d + unitsPerPx) * (d + unitsPerPx), 1e-4);
            float windowedNext = litInverseSquare(d + unitsPerPx, 2.0);
            float risePlain = (plainNext - plain) * yScale;
            float riseWindowed = (windowedNext - windowed) * yScale;
            paint = mix(paint, vec3(0.6, 0.62, 0.68),
                        lampCardInk(abs(box.y - plain * yScale) / sqrt(1.0 + risePlain * risePlain)));
            paint = mix(paint, vec3(1.0, 0.7, 0.2),
                        lampCardInk(abs(box.y - windowed * yScale) / sqrt(1.0 + riseWindowed * riseWindowed)));
        }
    }
    color = vec4(paint, 1.0);
}
