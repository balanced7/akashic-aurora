//! {"card": "volume-integrate", "uses": ["volume-integrate"], "t": [0], "size": [480, 270],
//!  "note": "A uniform slab of lit fog over a grey checkerboard; across the card its optical depth grows from 0 (left)
//!  to 5 (right). The fog dims blue faster than red, so the checker shows warm through it before it disappears. UPPER
//!  PANEL (the module's exact steps): three bands, from its bottom 1, 4 and 32 steps; all three are the SAME picture,
//!  with no brightness step from band to band, the checker fading out and the fog settling on a flat warm grey (albedo
//!  times light, about 0.81, 0.69, 0.52). LOWER PANEL (the naive order written in the card for contrast: add light,
//!  then dim): the same three bands disagree: the 1-step band blows out to white well before the right edge, the 4-step
//!  band is clearly brighter than the 32-step one, and the 32-step band is only slightly brighter than the upper panel.
//!  TOP STRIP: red from where volSaturated(T < 0.05) would end the march (about three quarters across), grey before.
//!  BOTTOM STRIPS: volStepEmit; the lower one has no absorption and climbs as a straight teal ramp, the upper one
//!  absorbs and levels off. A step between the upper panel's bands, a white blow-out in it, or a ramp that bends at
//!  zero absorption is a broken module."}
// Apache-2.0, Akashic Aurora. The test card of volume/integrate.glsl, written fresh for the house.

const float CARD_DEPTH_MAX = 5.0;      // optical depth of the slab at the right edge (the slab is one unit thick)
const float CARD_BAND = 39.0;          // height of one band in pixels

// The backdrop: a 12-pixel checkerboard of two greys.
vec3 integrateCardChecker(vec2 pixel) {
    vec2 cell = floor(pixel / 12.0);
    return mod(cell.x + cell.y, 2.0) < 0.5 ? vec3(0.08) : vec3(0.35);
}

// One unit of uniform fog of optical depth tau, marched in `steps` steps, exactly or in the naive order.
vec3 integrateCardSlab(float tau, int steps, bool exact, vec3 background, out bool saturated) {
    vec3 sigmaT = tau * vec3(0.8, 1.0, 1.3);
    vec3 sigmaS = 0.9 * sigmaT;
    vec3 light = vec3(0.9, 0.77, 0.58);
    float dt = 1.0 / float(steps);
    VolAccum a = volAccumInit();
    for (int slice = 0; slice < 32; ++slice) {
        if (slice >= steps) break;
        if (exact) {
            volStepScatter(a, sigmaS, sigmaT, light, dt);
        } else {
            a.L += a.T * sigmaS * light * dt;                  // naive: the slice's light at full strength ...
            a.T *= volTransmittance3(sigmaT, dt);              // ... then the dimming, too late for its own light
        }
    }
    saturated = volSaturated(a, 0.05);
    return volResolve(a, background);
}

void mainImage(out vec4 color, in vec2 pixel) {
    float across = clamp((pixel.x - 8.0) / 464.0, 0.0, 1.0);
    float tau = CARD_DEPTH_MAX * across;
    int stepsOf[3] = int[3](1, 4, 32);
    vec3 paint = vec3(0.02);
    bool saturated = false;
    if (pixel.y >= 140.0 && pixel.y < 140.0 + 3.0 * CARD_BAND) {
        int band = int((pixel.y - 140.0) / CARD_BAND);
        paint = integrateCardSlab(tau, stepsOf[band], true, integrateCardChecker(pixel), saturated);
        if (fract((pixel.y - 140.0) / CARD_BAND) * CARD_BAND < 1.0) paint *= 0.4;    // a hairline between bands
    } else if (pixel.y >= 16.0 && pixel.y < 16.0 + 3.0 * CARD_BAND) {
        int band = int((pixel.y - 16.0) / CARD_BAND);
        paint = integrateCardSlab(tau, stepsOf[band], false, integrateCardChecker(pixel), saturated);
        if (fract((pixel.y - 16.0) / CARD_BAND) * CARD_BAND < 1.0) paint *= 0.4;
    } else if (pixel.y >= 259.0) {
        integrateCardSlab(tau, 32, true, vec3(0.0), saturated);
        paint = saturated ? vec3(0.9, 0.1, 0.1) : vec3(0.15);
    } else if (pixel.y < 12.0) {
        VolAccum glow = volAccumInit();
        vec3 absorb = pixel.y < 6.0 ? vec3(0.0) : vec3(0.8);
        for (int slice = 0; slice < 8; ++slice) {
            volStepEmit(glow, vec3(0.03, 0.15, 0.1), absorb, tau / 8.0);
        }
        paint = glow.L;
    }
    color = vec4(paint, 1.0);
}
