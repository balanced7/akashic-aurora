//! {"card": "core-safe", "uses": ["core-safe"], "t": [0], "size": [480, 270],
//!  "note": "Six panels, every curve continuous and finite where the plain function would be undefined. Top: safeDiv(1, x, 0.1) holds at 10 and -10 (the dim lines) instead of shooting to infinity, and steps from -10 to +10 exactly at x = 0 (zero counts as positive); safeSqrt is flat at 0 for negative x; safeAcos is flat at pi and 0 beyond -1 and 1 (the dim verticals). Bottom left: safePow(x, 2.2) in orange and safePow(x, 0.45) in blue, both 0 for negative x. Bottom middle: a 9 by 9 grid of vectors coloured by direction, brighter the longer they are; the centre cell is the zero vector and shows the grey fallback, not NaN. Bottom right: finiteOr on three bands of a violet gradient. Left, the green channel is NaN and takes the fallback's 0.85 alone (a green gradient); middle, the red channel is Inf and takes the fallback's 0.95 alone (flat pink); right, every channel is finite and passes untouched (the violet gradient). The NaN probe finds nothing, because nothing broken reaches the screen."}
// Apache-2.0, Akashic Aurora. The test card for core/safe.glsl, written fresh: each guard is plotted across the edge of
// the domain it protects. Plotting the unguarded function beside it would put NaN on the card, which is the point.

// The curve each plot draws, by panel (GLSL has no function pointers).
float safeCardCurve(int panel, int which, float x) {
    if (panel == 0) {
        return safeDiv(1.0, x, 0.1);
    }
    if (panel == 1) {
        return safeSqrt(x);
    }
    if (panel == 2) {
        return safeAcos(x);
    }
    return which == 0 ? safePow(x, 2.2) : safePow(x, 0.45);
}

// The data window of each plot: x from .x to .y, y from .z to .w.
vec4 safeCardWindow(int panel) {
    if (panel == 0) {
        return vec4(-1.0, 1.0, -12.0, 12.0);
    }
    if (panel == 1) {
        return vec4(-0.5, 1.5, -0.2, 1.4);
    }
    if (panel == 2) {
        return vec4(-1.4, 1.4, -0.3, 3.5);
    }
    return vec4(-1.0, 1.0, -0.2, 1.2);
}

// Ink for a curve crossing this pixel column. It enters at one height and leaves at another (all three in pixels:
// the column's left edge, middle and right edge), so it covers the span between them; a pixel is lit by how close it
// is to that span. Flat, steep, a jump or an asymptote: each stays one even stroke.
float safeCardLine(float yPx, float leftPx, float middlePx, float rightPx) {
    float low = min(leftPx, min(middlePx, rightPx));
    float high = max(leftPx, max(middlePx, rightPx));
    float outside = max(max(low - yPx, yPx - high), 0.0);
    return 1.0 - smoothstep(0.5, 1.3, outside);
}

void mainImage(out vec4 color, in vec2 pixel) {
    vec2 panelSize = vec2(160.0, 135.0);
    int column = int(pixel.x / panelSize.x);
    int rowFromTop = int((iResolution.y - pixel.y) / panelSize.y);
    int panel = column + 3 * rowFromTop;
    vec2 inPanel = pixel - vec2(float(column) * panelSize.x, iResolution.y - float(rowFromTop + 1) * panelSize.y);
    vec2 plotMin = vec2(12.0, 12.0);
    vec2 plotSize = panelSize - 2.0 * plotMin;
    vec2 at01 = (inPanel - plotMin) / plotSize;          // 0..1 across the plot area
    bool inPlot = all(greaterThanEqual(at01, vec2(0.0))) && all(lessThanEqual(at01, vec2(1.0)));

    vec3 paint = vec3(0.04, 0.05, 0.07);
    if (inPlot) {
        paint = vec3(0.08, 0.09, 0.11);
    }

    if (panel < 4) {
        vec4 window = safeCardWindow(panel);
        vec2 perPixel = vec2(window.y - window.x, window.w - window.z) / plotSize;   // data units per pixel
        vec2 data = vec2(window.x, window.z) + at01 * vec2(window.y - window.x, window.w - window.z);
        // the axes, and the edges of each function's domain, dim
        float axisPx = min(abs(data.x) / perPixel.x, abs(data.y) / perPixel.y);
        if (panel == 0) {
            axisPx = min(axisPx, abs(abs(data.y) - 10.0) / perPixel.y);
        }
        if (panel == 2) {
            axisPx = min(axisPx, abs(abs(data.x) - 1.0) / perPixel.x);
        }
        paint = mix(paint, vec3(0.22, 0.24, 0.3), (1.0 - smoothstep(0.4, 1.0, axisPx)) * float(inPlot));
        int curves = panel == 3 ? 2 : 1;
        for (int which = 0; which < 2; which++) {
            if (which >= curves) {
                break;
            }
            vec3 heights = vec3(safeCardCurve(panel, which, data.x - 0.5 * perPixel.x),
                                safeCardCurve(panel, which, data.x),
                                safeCardCurve(panel, which, data.x + 0.5 * perPixel.x));
            vec3 heightsPx = (heights - window.z) / perPixel.y;
            float ink = safeCardLine(at01.y * plotSize.y, heightsPx.x, heightsPx.y, heightsPx.z);
            vec3 hue = which == 0 ? vec3(1.0, 0.62, 0.22) : vec3(0.4, 0.65, 1.0);
            paint = mix(paint, hue, ink * float(inPlot));
        }
    } else if (panel == 4 && inPlot) {
        // safeNormalize on a 9 by 9 grid of vectors; the middle cell holds exactly (0, 0)
        vec2 cell = floor((at01 * 2.0 - 1.0) * 4.5 + 0.5) / 4.5;
        vec2 heading = safeNormalize(cell, vec2(0.0));
        float reach = min(dot2(cell), 1.0);
        vec3 tint = 0.5 + 0.5 * vec3(heading.x, heading.y, -heading.x);
        paint = tint * (0.45 + 0.55 * reach);
        vec2 fromCellMiddle = abs(fract((at01 * 2.0 - 1.0) * 4.5 + 0.5) - 0.5);
        float toCellBorder = 0.5 - max(fromCellMiddle.x, fromCellMiddle.y);     // in cells; a cell is 15 pixels
        paint *= 0.6 + 0.4 * smoothstep(0.02, 0.08, toCellBorder);
    } else if (panel == 5 && inPlot) {
        // finiteOr on three bands: a NaN channel, an Inf channel, finite values
        float notANumber = intBitsToFloat(0x7fc00000 + int(iTime));      // a quiet NaN; iTime stops it folding
        float infinite = intBitsToFloat(0x7f800000 + int(iTime) * 0);     // +Inf
        vec4 sample0 = vec4(0.25 + 0.5 * at01.y, 0.3, 0.55, 1.0);
        if (at01.x < 1.0 / 3.0) {
            sample0.g = notANumber;
        } else if (at01.x < 2.0 / 3.0) {
            sample0.r = infinite;
        }
        vec4 fallback = vec4(0.95, 0.85, 0.2, 1.0);
        paint = finiteOr(sample0, fallback).rgb;
    }
    color = vec4(paint, 1.0);
}
