      "target": {"x_scale": 1.8, "y": {"0": 26, "1": 15, "2": 8}, "z": 30},
      "shift_y": "$layer_shift",
      "about": "each third aims out over the crowd at its own altitude: top 26 m, middle 15 m, bottom 8 m where the rays cross z = 30 m"
    },
    "horizon": {"feature": "Position", "kind": "values", "values": {"Pan": 0, "Tilt": 86}},
    "vertical": {"feature": "Position", "kind": "values", "values": {"Pan": 0, "Tilt": 0}},
    "corona": {"feature": "Position", "kind": "radial", "forward_deg": 25, "about": "radially out from the ring centre, tipped 25 degrees toward the crowd"}
  },
  "phrases": {
    "halo-levels": {
      "name": "Halo Levels",
      "about": "Daniel, 2026-10-25: 'you can have top, midle then bottom pan up and down sequentially. or horizontal flash and pan, then vertical 1, 2, 3 then back to lasers, then a cool pattern of lights from the circular halo.' The levels are the altitude thirds of the circular array, one step per beat; his second pattern is top and bottom, middle, top and bottom again.",
      "bars": 8,
      "go": "bar",
      "sections": ["groove", "drop", "build", "break"],
      "base": [
        {"group": "halo", "preset": "layers", "values": {"Dimmer": 0, "Zoom": 1.2, "Color": "$colour"}},
        {"group": "hrow", "preset": "horizon", "values": {"Dimmer": 0, "Pan": "$hpan_start", "Zoom": 1.0, "Color": "W"}},
        {"group": "vert", "preset": "vertical", "values": {"Dimmer": 0, "Zoom": 0.8, "Color": "W"}},
        {"group": "vert.delay", "preset": "vertical", "values": {"Dimmer": 0, "Zoom": 0.8, "Color": "W"}},
        {"group": "vert.strips", "values": {"Dimmer": 0, "Color": "W"}},
        {"group": "truss.heads", "values": {"Dimmer": 0}},
        {"group": "strand.heads", "values": {"Dimmer": 0.3}}
      ],
      "steps": [
        {
          "id": "A",
          "name": "levels",
          "beats": 12,
          "trigger": "follow",
          "lines": [
            {"group": "halo", "preset": "layers", "values": {"Dimmer": 0, "Zoom": 1.2, "Color": "$colour"}, "effects": ["levels-step"]},
            {"group": "halo.lasers", "laser": {"shape": "levels", "schedule": "levels-step", "colour": 2, "level": 0.8}},
            {"group": "rings.slats", "values": {"Dimmer": 0.05, "Color": "bumpA", "Color2": "bumpB"}, "effects": ["ring-colour-bump"]},
            {"group": "rings.rims", "values": {"Dimmer": 0.5, "Color": "W"}}
          ],
          "camera": {"shot": "HALO_LOCK", "alt": "UNDER_LAYERS"}
        },
        {
          "id": "B",
          "name": "horizontal flash and pan",
          "beats": 4,
          "trigger": "follow",
          "lines": [
            {
              "group": "hrow",
              "preset": "horizon",
              "values": {"Dimmer": 0.6, "Zoom": 1.0, "Color": "W"},
              "flash": {"at": 0, "to": 1.0, "decay_beats": 0.5, "via": "FlashGate", "refused": "lift"},
              "effects": [{"name": "hrow-pan", "with": {"size": "$hpan", "phase": {"reverse": "$hpan_reverse"}}}]
            },
            {"group": "halo", "values": {"Dimmer": 0}, "fade": 0.25}
          ],
          "camera": {"shot": "WING_LAYERS", "precut_beats": 1}
        },
        {
          "id": "C",
          "name": "verticals 1-2-3",
          "beats": 4,
          "trigger": "follow",
          "lines": [
            {"group": "vert", "preset": "vertical", "values": {"Dimmer": 0, "Zoom": 0.8, "Color": "$vert_colour"}, "effects": ["vert-step"]},
            {"group": "vert.strips", "values": {"Dimmer": 0, "Color": "$vert_colour"}, "effects": ["vert-step"]},
            {"group": "hrow", "values": {"Dimmer": 0}, "fade": 0.5}
          ],
          "camera": {"shot": "FOH_WIDE", "alt": "TRIBUNE_34"}
        },
        {
          "id": "D",
          "name": "back to lasers",
          "beats": 8,
          "trigger": "follow",
          "ambient": 0,
          "lines": [
            {"group": "heads.all", "values": {"Dimmer": 0}},
            {"group": "halo", "preset": "corona", "values": {"Dimmer": 0, "Zoom": 2.0}},
            {"group": "leds.all", "values": {"Dimmer": 0.01}},
            {"group": "lasers", "laser": {"shape": "bloom", "open_beats": 1, "colour": "$laser_colour", "level": 0.9, "until_beats": 2}},
            {"group": "lasers.B", "laser": {"shape": "ceiling", "colour": "$laser_colour", "level": 0.75, "from_beats": 2}},
            {"group": "lasers.AS", "laser": {"shape": "scissors", "colour": "$laser_colour2", "level": 0.7, "from_beats": 2}}
          ],
          "camera": {"shot": "CROWD_POV", "then": {"beats": 4, "shot": "WORM_RING"}}
        },
        {
          "id": "E",
          "name": "halo pattern",
          "beats": 4,
          "trigger": "follow",
          "lines": [
            {
              "group": "$halo_group",
              "preset": "corona",
              "values": {"Dimmer": 0.4, "Zoom": 1.4, "Color": "beamB"},
              "effects": [{"name": "corona-chop", "with": {"offset": "$chop_offset", "phase": {"to": "$chop_to"}}}]
            },
            {
              "group": "rings.slats",
              "values": {"Dimmer": 0.9, "Color": "W", "Color2": "A"},
              "effects": [{"name": "ring-chopper", "with": {"offset": "$chop_offset", "phase": {"to": "$chop_to"}}}]
            },
            {"group": "halo.lasers", "laser": {"shape": "rim-corona", "follow": "ring-chopper", "colour": 2, "level": 0.8}},
            {"group": "lasers.core", "laser": {"shape": "ceiling", "colour": 0, "level": 0.3}}
          ],
          "cues": [{"at": 3, "lines": [{"group": "halo", "preset": "layers", "values": {"Dimmer": 0}, "fade": 0.5}]}],
          "camera": {"shot": "HALO_ORBIT"}
        }
      ],
      "vary": {
        "deck": ["daniel", "pinch", "ascend", "rush", "depth"],
        "first": "daniel",
        "no_repeat": true,
        "variants": {
          "daniel": {},
          "pinch": {"steps": {"A": {"swap": {"levels-step": "pinch-step"}, "laser_schedule": "pinch-step"}}},
          "ascend": {"steps": {"A": {"patch": {"levels-step": {"phase": {"reverse": true}}}}, "C": {"patch": {"vert-step": {"phase": {"reverse": true}}}}}},
          "rush": {
            "sections": ["build", "break"],
            "steps": {
              "A": {
                "split": [{"beats": 8}, {"beats": 4, "swap": {"levels-step": "levels-rush"}, "drop_effects": ["levels-nod"], "laser_schedule": "levels-rush"}]
              }
            }
          },
          "depth": {
            "steps": {
              "C": {
                "lines": [
                  {
                    "group": "vert.depth",
                    "preset": "vertical",
                    "values": {"Dimmer": 0, "Zoom": 0.8, "Color": "$vert_colour"},
                    "effects": ["vert-depth"]
                  },
                  {"group": "hrow", "values": {"Dimmer": 0}, "fade": 0.5}
                ],
                "camera": {"shot": "SIDE_TRACK_PARALLEL"}
              }
            }
          }
        },
        "per_repeat": {
          "colour": {"cycle": ["beamA", "W", "beamB"]},
          "chop_offset": {"add": 0.2856, "mod": 1},
          "chop_to": {"alternate": [-720, 720]},
          "hpan": {"alternate": [40, -40]},
          "hpan_start": {"alternate": [-40, 40]},
          "hpan_reverse": {"alternate": [false, true]},
          "layer_shift": {"seeded": [-2, 2]},
          "halo_group": {"cycle": ["halo", "halo.r0", "halo.r1", "halo.r2"]},
          "camera_alt": {"alternate": [false, true]},
          "vert_colour": {"cycle": ["W", "beamB", "A"]},
          "laser_colour": {"cycle": [0, 2, 1]},
          "laser_colour2": {"cycle": [1, 0, 2]}
        }
      }
    }
  }
}
