//! {"name": "superlinear-highlight", "kind": "modifier", "from": "the c*c term of the wave shader", "note": "Squaring leaves the dark two-thirds essentially untouched and pays out only at the crests, so mids sink toward black while bright nodes bloom. This is how an image gets DARKER and more striking at once instead of trading one for the other. Put it BEFORE tanh or the shoulder gets re-expanded.", "order": 50, "cat": "tone", "in": {"col": "vec3"}, "out": {"col": "vec3"}}
col += col * col * 0.85;
