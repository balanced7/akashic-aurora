{
  "name": "akashic-aurora-web",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/**",
      "config/*"
    ],
    "catalog": {
      "@tanstack/react-query": "5.90.16",
      "@tanstack/react-query-devtools": "5.91.2",
      "@tanstack/react-table": "8.21.3",
      "@vitest/coverage-v8": "4.0.16",
      "envin": "1.1.12",
      "eslint": "9.39.2",
      "prettier": "3.7.4",
      "react-hook-form": "7.69.0",
      "react-native": "0.83.1",
      "typescript": "5.9.3",
      "vitest": "4.0.16",
      "zod": "4.2.1"
    },
    "catalogs": {
      "node22": {
        "@types/node": "^25.0.3"
      },
      "react19": {
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "react": "^19.2.3",
        "react-dom": "^19.2.3"
      }
    }
  },
  "scripts": {
    "build": "turbo run build --filter=./apps/* --filter=./packages/** --filter=./config/*",
    "dev:web": "turbo run dev --filter=web",
    "format": "turbo run format --continue --filter=./apps/* --filter=./packages/** --filter=./config/* -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue --filter=./apps/* --filter=./packages/** --filter=./config/* -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue --filter=./apps/* --filter=./packages/** --filter=./config/* -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue --filter=./apps/* --filter=./packages/** --filter=./config/* -- --fix --cache --cache-location .cache/.eslintcache",
    "test": "turbo run test --filter=./apps/* --filter=./packages/** --filter=./config/*",
    "typecheck": "turbo run typecheck --filter=./apps/* --filter=./packages/** --filter=./config/*"
  },
  "devDependencies": {
    "@akashic-labs/prettier-config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "prettier": "@akashic-labs/prettier-config",
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
