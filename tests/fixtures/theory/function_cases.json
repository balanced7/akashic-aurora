{
  "api": "arsenal.piano.theory.function_cases/v1",
  "about": "Function-label corpus for arsenal/web/piano/function.js and its Python twin arsenal/harmony_function.py (theory-nextgen-spec 2.5, TN0; frozen after TN0). NG8: 100% in JS and Python. Synthetic progressions written by hand, plus the 9 no-pause key-change shapes of S1-S6 as number sequences (design-engine 9.3) with synthetic durations. Labels follow practice.py classify (diatonic, secondary dominant, borrowed, modal, chromatic) with the spec's additions (backdoor, tritone substitute, passing diminished, from the old key).",
  "conventions": {
    "windows": "in order; chord is a name nashville.js reads, number its text in the window's area key (checked), seconds its synthetic length; kind note or interval marks a non-chord window; notes (optional) the voicing when the name alone is ambiguous",
    "areas": "key areas by the index of their first window; before is the key of the area before the first window, when that area has no window here",
    "order": "a window takes the first label that fits: diatonic (a minor key's natural, harmonic or melodic scale); from the old key; secondary dominant; backdoor; tritone substitute; passing diminished; borrowed; modal colour; chromatic",
    "diatonic": "every pitch class on one of the key's home scales (major; or natural, harmonic, melodic minor)",
    "from the old key": "from a key area's start until its tonic chord has sounded 1.5 s in all, or 8 s have passed: a window diatonic in the previous area's key. detail.old_key and detail.old_number (its number in that key)",
    "secondary dominant": "a major 3rd and no major 7th on a root a 5th above a diatonic target (major key: 2m 3m 4 5 6m; minor key: b3 4m 5 b6 b7), with a b7, or landing on the target next. target is that number; detail.lands says whether the next window's root is the target",
    "backdoor": "a dominant seventh on b7 whose next window is on the tonic",
    "tritone substitute": "a dominant seventh a half step above the next window's root, landing there on a diatonic chord; target is that chord's number",
    "passing diminished": "a diminished chord on #1 or #4 whose next window's root is a half step above; target is that chord's core number",
    "borrowed": "every pitch class on the parallel key's scales (a major key borrows from natural or harmonic minor, a minor key from major); detail.from names the parallel key",
    "modal colour": "every pitch class on a mode of the tonic (major key: Mixolydian, Lydian, Dorian, Phrygian; minor key: Dorian, Phrygian); detail.mode",
    "chromatic": "none of these",
    "note": "a single-note window has no function label (label null)",
    "confirmed": "for the gospel 5 over 4 (design-engine 9.9): the reading the next window confirms, which the log and the practice summary take; Bb11/Ab when the next bass steps down to the key's 3 or the next chord is 1/3, else Ab6/9#11",
    "match": "detail is matched as a subset: every expected detail field must equal the result's"
  },
  "labels": {
    "diatonic": "fn.diatonic",
    "secondary dominant": "fn.secondary_dominant",
    "backdoor": "fn.backdoor",
    "tritone substitute": "fn.tritone_sub",
    "passing diminished": "fn.passing",
    "from the old key": "fn.from_old_key",
    "borrowed": "fn.borrowed",
    "modal colour": "fn.modal",
    "chromatic": "fn.chromatic"
  },
  "cases": [
