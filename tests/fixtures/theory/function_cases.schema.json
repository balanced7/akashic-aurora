{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arsenal.piano.theory.function_cases.schema/v1",
  "title": "function_cases.json",
  "type": "object",
  "required": ["api", "about", "conventions", "labels", "cases"],
  "additionalProperties": false,
  "properties": {
    "api": { "const": "arsenal.piano.theory.function_cases/v1" },
    "about": { "type": "string" },
    "conventions": { "type": "object" },
    "labels": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^fn\\." } },
    "cases": { "type": "array", "minItems": 40, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[A-G](#|b)? (major|minor)$" },
    "label": { "enum": ["diatonic", "secondary dominant", "backdoor", "tritone substitute", "passing diminished", "from the old key", "borrowed", "modal colour", "chromatic"] },
    "case": {
      "type": "object",
      "required": ["id", "group", "title", "areas", "before", "windows", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]-[0-9]{2}[a-z]?$" },
        "group": { "enum": ["cadence", "secondary-dominant", "backdoor", "tritone", "passing", "borrowed", "modal", "chromatic", "daniel", "gospel", "minor", "key-change"] },
        "title": { "type": "string" },
        "areas": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["key", "from"], "additionalProperties": false, "properties": { "key": { "$ref": "#/$defs/key" }, "from": { "type": "integer", "minimum": 0 } } }
        },
        "before": { "anyOf": [{ "$ref": "#/$defs/key" }, { "type": "null" }] },
        "windows": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "required": ["chord", "number", "seconds"], "additionalProperties": false,
            "properties": {
              "chord": { "type": "string", "minLength": 1 },
              "number": { "type": "string", "minLength": 1 },
              "seconds": { "type": "number", "exclusiveMinimum": 0 },
              "kind": { "enum": ["note", "interval"] },
              "notes": { "type": "string", "pattern": "^[A-G](#|b)?-?[0-9]( [A-G](#|b)?-?[0-9])*$" }
            }
          }
        },
        "expect": {
          "type": "array",
          "items": {
            "type": "object", "required": ["at", "label"], "additionalProperties": false,
            "properties": {
              "at": { "type": "integer", "minimum": 0 },
              "label": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
              "lexId": { "type": "string", "pattern": "^fn\\." },
              "target": { "type": "string" },
              "detail": { "type": "object" },
              "confirmed": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
