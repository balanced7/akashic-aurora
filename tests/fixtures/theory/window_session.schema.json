{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arsenal.piano.theory.window_session.schema/v1",
  "title": "window_sessions/*.json",
  "description": "A synthetic note stream and the window starts harmony.js must find in it (NG5: 100%). Events use the performance log's kinds (on, off, sound_end, pedal) plus a source; only midi, keys and demo reach the tracker (H2). tick_ms: the replay tick intervals that must give identical windows (H4).",
  "type": "object",
  "required": ["api", "id", "about", "key", "profile", "same_as", "tick_ms", "expect", "events"],
  "additionalProperties": false,
  "properties": {
    "api": { "const": "arsenal.piano.theory.window_session/v1" },
    "id": { "type": "string", "pattern": "^ws[0-9]{2}-[a-z0-9-]+$" },
    "about": { "type": "string" },
    "key": { "type": "string", "pattern": "^[A-G](#|b)? (major|minor)$" },
    "profile": {
      "type": "object", "required": ["gap_ms", "pedal_down_share", "sources"], "additionalProperties": false,
      "properties": {
        "gap_ms": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "pedal_down_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "same_as": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "tick_ms": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "expect": {
      "type": "object", "required": ["tolerance_ms", "end_ms", "windows"], "additionalProperties": false,
      "properties": {
        "tolerance_ms": { "type": "number", "minimum": 0 },
        "end_ms": { "type": "number", "minimum": 0 },
        "windows": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["start_ms", "cause", "played"], "additionalProperties": false,
            "properties": {
              "start_ms": { "type": "number", "minimum": 0 },
              "cause": { "enum": ["first", "silence", "new bass", "change"] },
              "played": { "type": "string" }
            }
          }
        }
      }
    },
    "events": { "type": "array", "minItems": 2, "items": { "$ref": "contracts.schema.json#/$defs/NoteEvent" } }
  }
}
