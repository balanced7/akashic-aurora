{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arsenal.piano.theory.lexicon.schema/v1",
  "title": "lexicon.json",
  "type": "object",
  "required": ["api", "about", "guard", "placeholders", "caption_grammar", "labels", "captions", "entries"],
  "additionalProperties": false,
  "properties": {
    "api": { "const": "arsenal.piano.theory.lexicon/v1" },
    "about": { "type": "string" },
    "guard": {
      "type": "object", "required": ["never", "never_symbols", "rule"], "additionalProperties": false,
      "properties": {
        "never": { "type": "array", "minItems": 8, "items": { "type": "string" } },
        "never_symbols": { "type": "array", "items": { "type": "string" } },
        "rule": { "type": "string" }
      }
    },
    "placeholders": { "type": "array", "items": { "type": "string", "pattern": "^<[a-z ]+>$" } },
    "caption_grammar": { "type": "string" },
    "labels": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^fn\\." } },
    "captions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["priority", "label", "situation", "runs", "example"], "additionalProperties": false,
        "properties": {
          "priority": { "type": "integer", "minimum": 0, "maximum": 4 },
          "label": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "situation": { "type": "string" },
          "example": { "type": "string" },
          "runs": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "object", "required": ["lex", "part", "role"], "additionalProperties": false, "properties": { "lex": { "type": "string" }, "part": { "enum": ["plain", "theory"] }, "role": { "enum": ["plain", "theory", "key"] } } },
                { "type": "object", "required": ["slot", "role"], "additionalProperties": false, "properties": { "slot": { "type": "string", "pattern": "^<[a-z ]+>$" }, "role": { "enum": ["plain", "theory", "key"] } } }
              ]
            }
          }
        }
      }
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "surface", "plain", "theory", "meaning"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z0-9_]+$" },
          "surface": { "type": "array", "minItems": 1, "items": { "enum": ["row", "chip", "hud", "practice", "study"] } },
          "plain": { "type": "string", "minLength": 1 },
          "theory": { "type": "string" },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
