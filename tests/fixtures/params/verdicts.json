     "ok": false, "patch": {}, "problems": [["intensity", "type"], ["levels", "choice"], ["offset", "type"]]},
    {"name": "a numeric choice matches as a double, the way JavaScript reads it", "set": "edge",
     "values": {"huge": 1152921504606846977}, "ok": true, "patch": {"huge": 1152921504606846976}, "problems": []},
    {"name": "an integer past 2^53 is the double JavaScript reads, at the end of a range too", "set": "edge",
     "values": {"top": 1152921504606846977, "topv": [1152921504606846977, 0]}, "ok": true, "patch": {"top": 1152921504606846976, "topv": [1152921504606846976, 0]}, "problems": []},
    {"name": "a derived expression past the 128-token cap is refused the same way on both twins", "set": "deep",
