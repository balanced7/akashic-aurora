    {"name": "a step below a millionth snaps to its own grid", "set": "edge", "values": {"fine": 0.12345678},
     "ok": true, "patch": {"fine": 0.1234568}, "problems": []},
    {"name": "unknown keys sort by UTF-16 code units, the way JavaScript sorts", "set": "core", "values": {"😀": 1, "\uff21": 2, "a": 3},
     "ok": false, "patch": {}, "problems": [["a", "unknown"], ["😀", "unknown"], ["\uff21", "unknown"]]},
    {"name": "an integer too big for a double is a bad number, not a crash", "set": "core",
