     "ok": true, "patch": {"countImplied": 27, "bits": 8, "px": 2.5, "kelvin": 6500, "db": -6}, "problems": []},
    {"name": "a step below a millionth keeps its decimals (the default does not round to a whole number)", "set": "edge",
