    {"name": "null takes every default", "set": "core", "values": null, "ok": true, "patch": {}, "problems": []},
    {"name": "good values pass and the derived param follows", "set": "core",
     "values": {"intensity": 1.5, "layers": 30, "mode": "aces", "levels": 2, "rays": false, "tint": [0.18, 0.18, 0.18], "offset": [0.25, -0.5]},
     "ok": true, "patch": {"intensity": 1.5, "layers": 30, "mode": "aces", "levels": 2, "rays": false, "tint": [0.18, 0.18, 0.18], "offset": [0.25, -0.5], "glow": 3},
     "problems": []},
    {"name": "values snap to the step grid without a problem", "set": "core",
     "values": {"intensity": 0.333, "hemHeight": 1.23456789, "layers": 26.4, "offset": [0.26, 0]},
     "ok": true, "patch": {"intensity": 0.33, "hemHeight": 1.234568, "layers": 26, "offset": [0.25, 0], "glow": 0.66}, "problems": []},
    {"name": "out of range clamps and says so", "set": "core",
     "values": {"intensity": 5, "layers": 2, "freq": 0, "ev": -10, "offset": [3, -3]},
     "ok": false, "patch": {"intensity": 2, "layers": 8, "freq": 20, "ev": -4, "offset": [1, -1], "glow": 4},
     "problems": [["intensity", "range"], ["layers", "range"], ["freq", "range"], ["ev", "range"], ["offset", "range"]]},
    {"name": "wrong types fall back to the default", "set": "core",
