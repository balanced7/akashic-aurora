    {"name": "a numeric choice matches by number", "set": "core", "values": {"levels": 2.0},
     "ok": true, "patch": {"levels": 2}, "problems": []},
    {"name": "null is a bad value, not a missing one (the looks registry refuses it too)", "set": "core",
