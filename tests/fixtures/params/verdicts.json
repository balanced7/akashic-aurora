    "core": {"intensity": 1, "hemHeight": 1.2, "layers": 26, "freq": 440, "ev": 0, "mode": "tanh", "levels": 1, "rays": true,
             "tint": [1, 0.5, 0.25], "offset": [0, 0.5], "glow": 2, "angle": 90},
    "strings": {"framing": "9:16", "name": "plain"},
    "units": {"r01": 0.5, "r01free": 0.5, "r01fine": 0.5, "r2": 1, "world": 1.2, "count": 26, "countImplied": 26, "hz": 440,
              "stops": 0, "db": 0, "deg": 90, "rad": 1, "turns": 0.25, "sec": 1, "persec": 0.25, "kelvin": 6500, "nm": 550,
              "px": 2, "bits": 8, "on": false, "pick": "a", "col": [0, 0, 0], "v3": [0.1, 0.2, 0.3], "exp01": 0.1, "lin02": 1},
    "edge": {"fine": 0.5, "big": 0, "huge": 0, "top": 0, "topv": [0, 0]},
    "deep": {"a": 0.5, "atCap": 31, "overCap": 0, "parens": 0},
    "tiny": {"logTiny": 1e-7, "narrow": 5e-7, "below": 1e-10}
  },
  "validate": [
