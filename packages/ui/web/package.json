{
  "name": "@akashic-labs/ui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.tsx"
  },
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ui:add": "bunx shadcn@latest add && prettier src --write --list-different"
  },
  "prettier": "@akashic-labs/prettier-config",
  "dependencies": {
    "@akashic-labs/i18n": "workspace:*",
    "@akashic-labs/shared": "workspace:*",
    "@akashic-labs/ui": "workspace:*",
    "@tanstack/react-table": "catalog:",
    "@radix-ui/react-progress": "1.1.0",
    "cmdk": "1.1.1",
    "input-otp": "1.4.2",
    "lucide-react": "0.562.0",
    "radix-ui": "1.4.3",
    "react-day-picker": "9.13.0",
    "recharts": "3.6.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@akashic-labs/eslint-config": "workspace:*",
    "@akashic-labs/prettier-config": "workspace:*",
    "@akashic-labs/tsconfig": "workspace:*",
    "@tailwindcss/typography": "0.5.19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "react-hook-form": "catalog:",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
