{
  "name": "@akashic-labs/email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "dotenv -e ../../apps/web/.env.local -c -- email dev --port 3095 --dir src/templates",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@akashic-labs/prettier-config",
  "dependencies": {
    "@akashic-labs/i18n": "workspace:*",
    "@akashic-labs/ui": "workspace:*",
    "@react-email/components": "1.0.3",
    "nodemailer": "7.0.12",
    "react-email": "5.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@akashic-labs/eslint-config": "workspace:*",
    "@akashic-labs/prettier-config": "workspace:*",
    "@akashic-labs/shared": "workspace:*",
    "@akashic-labs/tsconfig": "workspace:*",
    "@react-email/preview-server": "5.1.1",
    "@types/nodemailer": "7.0.4",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
