{
  "name": "@akashic-labs/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@akashic-labs/prettier-config",
  "dependencies": {
    "@akashic-labs/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.958.0",
    "@aws-sdk/s3-request-presigner": "3.958.0"
  },
  "devDependencies": {
    "@akashic-labs/eslint-config": "workspace:*",
    "@akashic-labs/prettier-config": "workspace:*",
    "@akashic-labs/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
