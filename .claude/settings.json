      "Bash(py agent_cli.py hooks status*)",
      "mcp__akashic-aurora__log",
      "mcp__akashic-aurora__bifrost_send",
      "Edit(research/reviewed/**)",
      "Bash(py scripts/bifrost_wake.py*)",
      "Bash(uv run scripts/bifrost_wake.py*)",
      "Bash(py agent_cli.py unwedge*)",
      "Bash(uv run agent_cli.py unwedge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Glob|Grep|Task|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "AI_SETUP=\"$CLAUDE_PROJECT_DIR\" $(command -v uvw || command -v uv) run -p 3.12 --gui-script \"$CLAUDE_PROJECT_DIR/agent/harness/hooks/claude_trace.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "AI_SETUP=\"$CLAUDE_PROJECT_DIR\" $(command -v uvw || command -v uv) run -p 3.12 --gui-script \"$CLAUDE_PROJECT_DIR/agent/harness/hooks/claude_posttooluse.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_SETUP=\"$CLAUDE_PROJECT_DIR\" $(command -v uvw || command -v uv) run -p 3.12 --gui-script \"$CLAUDE_PROJECT_DIR/agent/harness/hooks/claude_stop.py\""
          }
        ]
      }
    ]
  }
}
