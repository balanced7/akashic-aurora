{
  "env": {
    "AKASHIC_AGENT_ID": "claude"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py scripts/hooks/claude_pretooluse.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py scripts/hooks/claude_pretooluse.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py scripts/hooks/claude_posttooluse.py"
          }
        ]
      }
    ]
  }
}
