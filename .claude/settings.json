{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py scripts/hooks/claude_pretooluse.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py scripts/hooks/claude_pretooluse.py"
          }
        ]
      }
    ]
  }
}
