{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bifrost-ui",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "scripts/bifrost_ui.py",
        "--port",
        "8790"
      ],
      "port": 8790,
      "autoPort": false
    },
    {
      "name": "arsenal-web",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "-m",
        "arsenal",
        "serve",
        "--port",
        "8793"
      ],
      "port": 8793,
      "autoPort": false
    }
  ]
}
